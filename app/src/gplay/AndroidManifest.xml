<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
      Artise, Play builds only. In the app's manifest, because a library's removal doesn't reach other libraries.
      Element asks for this to install APKs people send in chats. Google Play only allows it for apps whose main
      purpose is installing apps, so Artise drops it: an APK then opens in the system installer, which asks by itself.
    -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />

    <!-- Firebase Analytics is for usage statistics only: never the advertising ID. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <application>
        <!--
          Analytics runs only after the person says yes on "Help improve Artise" (FirebaseAnalyticsProvider turns it on).
          Until then nothing is collected. The push library deactivates analytics for good; Artise replaces that with
          "off until consent".
        -->
        <meta-data
            android:name="firebase_analytics_collection_deactivated"
            android:value="false"
            tools:replace="android:value" />
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_analytics_storage"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_storage"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_user_data"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_ssaid_collection_enabled"
            android:value="false" />
    </application>
</manifest>
